# Support Hub Dashboard Environment Configuration

# Production API Base URL (leave empty in local development to use Vite proxy)
# In Cloudflare Pages, set this to your deployed GCP backend URL (e.g. https://api-xyz.a.run.app)
VITE_API_BASE_URL=

# Widget Host URL (used to generate snippet embed codes in Dashboard)
# In production, set this to your deployed Cloudflare Pages / CDN widget URL (e.g. https://widget.yourdomain.com)
VITE_WIDGET_URL=http://localhost:5174
