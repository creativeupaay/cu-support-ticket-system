# Server Config
PORT=5001
NODE_ENV=development

# Database (optional in dev, will use in-memory mongo if unset or unreachable)
MONGODB_URI=mongodb://localhost:27017/support_hub

# JWT Secret for Agent Authentication
JWT_SECRET=super_secret_jwt_key_supporthub_12345

# Resend Email Integration
RESEND_API_KEY=
RESEND_FROM_EMAIL="Creative Upaay <noreply@creativeupaay.in>"
RESEND_NOTIFICATION_EMAIL="creativeupaay@gmail.com"

# Cloudinary Integration for Direct Browser Uploads (optional in dev, simulated if unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Cloud Storage (ADC Authenticated)
GCS_BUCKET_NAME=support-ticket-management
GCS_PROJECT_ID=cu-internal-tools

# URLs for CORS and Email Link Generation
CORS_DASHBOARD_ORIGIN=http://localhost:5173
STATUS_PAGE_BASE_URL=http://localhost:5173/status
WIDGET_ORIGIN=http://localhost:5174
